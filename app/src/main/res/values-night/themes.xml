<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Chut" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/Chut.Dialog</item>
    </style>
    <style name="Chut.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorPrimary">@color/brand</item>
    </style>
</resources>
